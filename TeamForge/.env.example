# TeamForge runs in LOCAL mode (browser storage only) when these are empty.
# Fill them in from Supabase dashboard → Project Settings → API to run in
# CLOUD mode against Supabase Auth, Postgres, Storage and Realtime.
VITE_SUPABASE_URL=
# The anon (or publishable) key — safe in the browser; Row Level Security guards the data.
VITE_SUPABASE_ANON_KEY=

# Seed the demo projects/users on first sign-in and let the demo accounts
# (password demo1234) self-provision. Also requires, in SQL:
#   update app_config set value = value || '{"allowDemoSeed": true}' where key = 'bootstrap';
# and "Confirm email" turned off under Authentication → Providers → Email.
VITE_SUPABASE_SEED_DEMO=false
